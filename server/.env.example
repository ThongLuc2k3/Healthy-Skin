PORT=4000
# Tạo chuỗi ngẫu nhiên dài, KHÔNG dùng giá trị mẫu này: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Gemini API key (miễn phí, không cần thẻ thanh toán) — tạo tại https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Chat Agent ưu tiên Groq; Gemini là dự phòng và vẫn dùng cho các tính năng quét ảnh.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# PostgreSQL connection string (Neon: dùng URL pooled có hostname chứa "-pooler")
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DB_POOL_MAX=10
# Co the khai bao nhieu origin, phan tach bang dau phay.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Cloudinary — nơi lưu MỌI ảnh/video người dùng tự tải lên (đánh giá, bình luận, Góc truyền động
# lực). BẮT BUỘC trên Render: ổ đĩa của Render free tier là tạm thời (ephemeral), lưu file local sẽ
# mất sạch sau mỗi lần deploy dù DB vẫn còn nguyên dòng trỏ tới đường dẫn đó, gây ảnh vỡ.
# Đăng ký miễn phí tại https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Provider thanh toán — để trống hoặc 'mock' (mặc định, không có tiền thật di chuyển) cho tới khi có
# tài khoản merchant thật. Xem server/src/payments/vnpayProvider.stub.js trước khi đổi giá trị này.
PAYMENT_PROVIDER=mock

# Shared secret tạm cho báo cáo đối soát nội bộ GET /api/settlement/summary (header x-admin-token).
# Để trống thì route luôn từ chối. Khác với tài khoản đăng nhập trang /admin bên dưới.
ADMIN_TOKEN=

# Tài khoản đăng nhập trang Admin Dashboard (/admin) — seed tự động khi server khởi động
# (server/src/services/adminAccountService.js). Để trống thì dùng giá trị mặc định trong code.
ADMIN_EMAIL=admin@healthyskin.local
ADMIN_PASSWORD=Admin@2026
