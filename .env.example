# De trong khi dev voi Vite proxy. Chi dat gia tri nay khi frontend can goi backend o domain/port khac.
# VITE_API_BASE_URL=
VITE_GOOGLE_CLIENT_ID=

# Backend PostgreSQL (bắt buộc)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Backend security / AI
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
